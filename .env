GOOGLE_SDK_PYTHON_LOGGING_SCOPE=google.cloud
GOOGLE_API_USE_MTLS_ENDPOINT=auto

# ==========================================
# Document AI & Storage Topology
# ==========================================
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=your_docai_processor_id
