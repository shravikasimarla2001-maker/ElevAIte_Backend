GOOGLE_CLOUD_PROJECT=career-copilot-506013
ENVIRONMENT=development
PORT=8080

# ==========================================
# Google Agent Engine & Search Identifiers
# ==========================================
# Non-secret routing IDs for web search and agent workflows
SEARCH_ENGINE_ID=017576662512468239146:omuauf_lfve
GOOGLE_CLOUD_AGENT_ENGINE_ID=projects/career-copilot-506013/locations/us-central1/reasoningEngines/8849201948

# ==========================================
# Cloud SQL / PostgreSQL Topology
# ==========================================
DB_HOST=10.0.0.3
DB_PORT=5432
DB_NAME=career_copilot
DB_USER=postgres
# Note: DB_PASSWORD is not stored here; it is fetched from Secret Manager

# ==========================================
# Google SDK Client Library Flags
# ==========================================
